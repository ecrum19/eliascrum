{
  "name": "personal_website",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "predev": "npm run build:cv",
    "dev": "vite",
    "preview": "vite preview",
    "prebuild": "npm run validate:content && npm run update:software-releases && npm run recent-work:export && npm run rdf:export && npm run build:cv",
    "build": "vite build",
    "lint": "eslint --ext .ts,.tsx,.vue src",
    "build:slides": "node scripts/build-slides.mjs",
    "build:cv": "node scripts/build-cv.mjs",
    "test:cv": "node --test scripts/cv/cv.test.mjs",
    "update:software-releases": "node scripts/update-software-releases.mjs",
    "update:alphabet-stock": "node scripts/update-alphabet-stock.mjs",
    "update:scholar": "node scripts/update-scholar-citations.mjs",
    "recent-work:export": "node scripts/export-recent-work.mjs",
    "rdf:export": "node scripts/export-rdf-data.mjs",
    "rdf:update": "node scripts/apply-rdf-update.mjs",
    "type-check": "vue-tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:queries": "node --test tests/queries/*.test.mjs",
    "validate": "npm run lint && npm run type-check && npm run validate:content && npm run test:coverage && npm run test:scripts && npm run test:queries && npm run test:cv",
    "validate:content": "node scripts/validate-content.mjs",
    "test:scripts": "vitest run --config vitest.scripts.config.mts --coverage",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "build:ci": "npm run validate && npm run build:site",
    "build:site": "npm run recent-work:export && npm run rdf:export && npm run build:cv && vite build"
  },
  "dependencies": {
    "@comunica/query-sparql": "^5.4.1",
    "core-js": "^3.51.0",
    "n3": "^2.13.12",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@playwright/test": "1.64.1",
    "@types/n3": "1.26.6",
    "@types/node": "24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "5.1.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "2.5.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "jsdom": "30.1.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  },
  "overrides": {
    "glob": "14.0.3",
    "minimatch": "11.0.4"
  }
}
